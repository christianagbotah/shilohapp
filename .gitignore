# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local database (contains admin password hash, Hubtel/SMS secrets, customer PII)
/db/
# database backups (same sensitive content)
/backups/
# agent tool output
/tool-results/

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/upload/

# isolated test databases (never commit payment test data)
/prisma/*.db
/prisma/*.db-shm
/prisma/*.db-wal
