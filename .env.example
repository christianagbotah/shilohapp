# Choose a persistent SQLite volume, not an ephemeral deploy layer.
DATABASE_URL="file:/absolute/persistent/shiloh/db/custom.db"
NEXT_PUBLIC_SITE_URL="https://your-shiloh-domain.example"
# Use absolute paths in production:
# SHILOH_DB_PATH="/persistent/shiloh/db/custom.db"
# SHILOH_BACKUP_DIR="/persistent/shiloh-backups"
# Generate an independent 32-byte base64 key with openssl rand -base64 32
# SHILOH_SETTINGS_ENCRYPTION_KEY must be set in host secrets, not committed.
# Set SHILOH_ADMIN_INITIAL_PASSWORD only while running the password setup command.
